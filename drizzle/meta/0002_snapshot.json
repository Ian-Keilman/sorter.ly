      "checkConstraints": {
        "fields_type_check": {
          "name": "fields_type_check",
          "value": "\"fields\".\"type\" in ('text', 'number', 'date', 'boolean', 'rating')"
        },
        "fields_configuration_check": {
          "name": "fields_configuration_check",
          "value": "case when json_valid(\"fields\".\"configuration\") then (\n        json_type(\"fields\".\"configuration\") = 'object'\n        and coalesce(json_extract(\"fields\".\"configuration\", '$.version') = 1, 0)\n        and (json_type(\"fields\".\"configuration\", '$.defaultValue') is null\n          or json_type(\"fields\".\"configuration\", '$.defaultValue') = 'text')\n        and coalesce((\n          (\"fields\".\"type\" = 'rating'\n            and json_type(\"fields\".\"configuration\", '$.rating') = 'object'\n            and json_extract(\"fields\".\"configuration\", '$.rating.maximum') in (5, 10, 100)\n            and json_extract(\"fields\".\"configuration\", '$.rating.step') in (1, 0.5, 0.1, 0.01))\n          or (\"fields\".\"type\" != 'rating'\n            and json_type(\"fields\".\"configuration\", '$.rating') is null)\n        ), 0)\n      ) else 0 end"
        },
        "fields_required_check": {
          "name": "fields_required_check",
          "value": "\"fields\".\"required\" in (0, 1)"
        }
      }
    },
